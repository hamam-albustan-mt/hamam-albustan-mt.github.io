rules_version = '2';

// قواعد حماية سجل حمام البستان.
// بس الحسابات اللي بريدها في القائمة تحت تقدر تقرأ أو تكتب أي شيء.
// لإضافة عامل أو مشرف: أضف بريده في القائمة (بين علامتي تنصيص وبعده فاصلة) ثم اضغط Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function allowed() {
      return request.auth != null
        && request.auth.token.email in [
          'kfs0541212244@gmail.com'
          // , 'worker1@gmail.com'
          // , 'supervisor@gmail.com'
        ];
    }

    match /{document=**} {
      allow read, write: if allowed();
    }
  }
}
